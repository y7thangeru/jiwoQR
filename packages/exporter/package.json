{
  "name": "@jiwoqr/exporter",
  "version": "1.0.0",
  "description": "3D (GLB, watertight STL, USDZ/Mobile AR) and 2D high-res print export engine for JiwoQR",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jiwoqr/core": "workspace:*",
    "@jiwoqr/math": "workspace:*",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/three": "^0.174.0",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7thangeru/jiwoQR.git",
    "directory": "packages/exporter"
  },
  "homepage": "https://github.com/y7thangeru/jiwoQR#readme",
  "bugs": {
    "url": "https://github.com/y7thangeru/jiwoQR/issues"
  },
  "keywords": [
    "jiwoqr",
    "exporter",
    "stl",
    "glb",
    "gltf",
    "usdz",
    "webxr",
    "ar-quick-look",
    "scene-viewer",
    "svg",
    "png",
    "3d-printing",
    "print"
  ],
  "author": "JiwoQR",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
