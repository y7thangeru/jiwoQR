{
  "name": "@jiwoqr/react",
  "version": "1.0.0",
  "description": "React component for procedural 3D JiwoQR codes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jiwoqr/core": "workspace:*",
    "@jiwoqr/renderer-webgl": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y7thangeru/jiwoQR.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/y7thangeru/jiwoQR#readme",
  "bugs": {
    "url": "https://github.com/y7thangeru/jiwoQR/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "qrcode",
    "3d",
    "procedural",
    "webgl",
    "threejs"
  ],
  "author": "JiwoQR",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
