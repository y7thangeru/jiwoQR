{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@jiwoqr/core": ["packages/core/src"],
      "@jiwoqr/math": ["packages/math/src"],
      "@jiwoqr/renderer-webgl": ["packages/renderer-webgl/src"],
      "@jiwoqr/exporter": ["packages/exporter/src"],
      "@jiwoqr/react": ["packages/react/src"]
    }
  }
}
