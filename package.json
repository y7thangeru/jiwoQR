{
  "name": "jiwoqr-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Next-generation procedural 3D QR code generator ecosystem",
  "packageManager": "pnpm@12.2.1",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
